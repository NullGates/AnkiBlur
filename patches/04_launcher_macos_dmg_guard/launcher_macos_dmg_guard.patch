+
+// AnkiBlur: true when the launcher is running straight off the mounted
+// disk image, or from Gatekeeper's app-translocation copy of it. Running
+// from there "works" transiently, but AnkiBlur.app itself never reaches
+// /Applications, so the app vanishes for the user once the image is
+// ejected. main.rs refuses to proceed in that case and tells the user to
+// drag the app onto the Applications shortcut shipped inside the DMG.
+pub fn running_from_dmg() -> bool {
+    let Ok(exe) = std::env::current_exe() else {
+        return false;
+    };
+    let path = exe.to_string_lossy();
+    path.starts_with("/Volumes/") || path.contains("/AppTranslocation/")
+}
