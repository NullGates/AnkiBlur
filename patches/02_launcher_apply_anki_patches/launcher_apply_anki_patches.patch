+/// AnkiBlur: whether this launcher can install the given Anki version at
+/// all. Upstream stopped publishing the anki-release meta-package after
+/// 26.5 (Anki moved to a bundled installer), so uv-style installs of
+/// anything newer can never resolve. Pre-25.06 versions install via the
+/// PyOxidizer scheme and are unaffected.
+fn ankiblur_installable(version: &str) -> bool {
+    let (major, minor, _, _) = parse_version_for_filtering(version);
+    major < 26 || (major == 26 && minor <= 5)
